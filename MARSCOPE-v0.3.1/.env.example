# Optional frontend API override. The default uses Vite's /api proxy to http://127.0.0.1:8000.
# Copy to frontend/.env.local only when the API is hosted elsewhere.
# VITE_API_BASE=https://your-api.example.org

# Optional server-side RAG generation. Leave unset to use deterministic, cited BM25 extractive answers.
# Never put OPENAI_API_KEY in a VITE_* variable or in the frontend.
OPENAI_API_KEY=
MARSCOPE_LLM_MODEL=gpt-6-astra
