# Optional frontend API override.
# Local development defaults to http://localhost:8000.
# For a separately hosted production frontend, set this to the public FastAPI URL.
# VITE_API_BASE=https://your-api.example.org

# Optional server-side RAG generation. Leave unset to use deterministic,
# cited BM25 extractive answers. Never put this key in a VITE_* variable.
OPENAI_API_KEY=
MARSCOPE_LLM_MODEL=gpt-6-astra
